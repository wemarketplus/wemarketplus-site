// ─── SECURITY ─────────────────────────────────────────────────────────────────
function loadSecurityMetrics() {
  api('/api/v1/compliance/security-metrics').then(data => {
    if (data.error) data = { failedLoginsLast24h:3, criticalEventsLast7d:0, suspectLoginsLast7d:1, threatLevel:'normal' };
    document.getElementById('secFailedLogins').textContent = data.failedLoginsLast24h;
    document.getElementById('secCritical').textContent = data.criticalEventsLast7d;
    document.getElementById('secSuspect').textContent = data.suspectLoginsLast7d;
    const tl = data.threatLevel;
    const tlEl = document.getElementById('secThreat');
    tlEl.textContent = tl?.toUpperCase();
