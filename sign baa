<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>HospiceLink — Sign BAA and Activate Account</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
html,body{font-family:'Segoe UI',system-ui,sans-serif;background:#05080f;color:#e8edf5}
body{display:flex;align-items:center;justify-content:center;min-height:100vh;padding:20px}
.wrap{width:100%;max-width:520px}
.logo{text-align:center;margin-bottom:24px}
.logo-mark{font-size:26px;font-weight:900;color:#4fa3e3;letter-spacing:-1px}
.logo-mark span{color:#4fc87a}
.card{background:#0d1b31;border:1px solid rgba(255,255,255,.09);border-radius:18px;padding:32px 28px}
.step-indicator{display:flex;gap:8px;margin-bottom:24px}
.step-dot{flex:1;height:3px;border-radius:2px;background:rgba(255,255,255,.1)}
.step-dot.done{background:#4fc87a}
.step-dot.active{background:#4fa3e3}
.card-title{font-size:20px;font-weight:800;margin-bottom:6px;letter-spacing:-.02em}
.card-sub{font-size:13px;color:#6b7fa3;margin-bottom:24px;line-height:1.55}
.baa-box{background:rgba(79,200,122,.05);border:1px solid rgba(79,200,122,.2);border-radius:10px;padding:16px;margin-bottom:20px;max-height:220px;overflow-y:auto;font-size:12px;color:#9ab;line-height:1.7}
.baa-box p{margin-bottom:8px}
.baa-box strong{color:#e8edf5}
.field{margin-bottom:16px}
.field label{display:block;font-size:12px;font-weight:700;color:#8b9fc4;margin-bottom:6px;letter-spacing:.04em;text-transform:uppercase}
.field input{width:100%;background:#0a1628;border:1px solid rgba(255,255,255,.12);border-radius:10px;padding:11px 14px;font-size:14px;color:#e8edf5;font-family:inherit;outline:none;transition:border-color .15s}
.field input:focus{border-color:#4fa3e3}
.agree-row{display:flex;gap:10px;align-items:flex-start;margin-bottom:20px;cursor:pointer}
.agree-row input[type=checkbox]{width:16px;height:16px;margin-top:2px;cursor:pointer;accent-color:#4fc87a;flex-shrink:0}
.agree-text{font-size:12px;color:#8b9fc4;line-height:1.55}
.agree-text a{color:#4fa3e3}
.strength{height:3px;border-radius:2px;margin-top:6px;background:#12253d;transition:all .2s}
.str-weak{background:#ef4444;width:30%}.str-mid{background:#f59e0b;width:65%}.str-strong{background:#4fc87a;width:100%}
.btn-main{width:100%;background:#4fc87a;color:#05080f;border:none;border-radius:999px;padding:13px;font-size:15px;font-weight:800;cursor:pointer;font-family:inherit;margin-top:4px;transition:opacity .15s}
.btn-main:hover{opacity:.88}
.btn-main:disabled{opacity:.4;cursor:not-allowed}
.err{background:rgba(239,68,68,.1);border:1px solid rgba(239,68,68,.3);border-radius:8px;padding:10px 14px;font-size:13px;color:#f87171;margin-bottom:14px;display:none}
.success-box{text-align:center;padding:16px 0;display:none}
.invalid-box{text-align:center;padding:16px 0;display:none}
.hipaa-note{background:rgba(79,163,227,.08);border:1px solid rgba(79,163,227,.2);border-radius:8px;padding:10px 14px;margin-bottom:16px;font-size:12px;color:#4fa3e3;line-height:1.6}
</style>
</head>
<body>
<div class="wrap">
  <div class="logo">
    <div class="logo-mark">Hospice<span>Link</span></div>
  </div>
  <div class="card">
    <div class="err" id="errMsg"></div>
    <div class="invalid-box" id="invalidBox">
      <p style="font-size:32px;margin-bottom:12px">&#x23F0;</p>
      <h3 style="color:#f87171;margin-bottom:8px">Link Expired</h3>
      <p style="font-size:13px;color:#6b7fa3;line-height:1.6">This activation link has expired (links are valid for 72 hours) or has already been used.<br>Please contact support to receive a new link.</p>
      <a href="mailto:support@wemarketplus.com" style="display:inline-block;margin-top:16px;background:#4fa3e3;color:#05080f;border-radius:999px;padding:10px 22px;text-decoration:none;font-weight:700;font-size:13px">Contact Support</a>
    </div>
    <div id="formSection">
      <div class="step-indicator">
        <div class="step-dot done"></div>
        <div class="step-dot done"></div>
        <div class="step-dot active"></div>
      </div>
      <div class="card-title">Sign Your BAA and Set Password</div>
      <div class="card-sub">Your payment is confirmed. To complete setup and activate your CRM, you must sign the Business Associate Agreement and set a password.</div>
      <div class="hipaa-note">
        <strong>HIPAA Requirement:</strong> A signed Business Associate Agreement (BAA) is legally required before you may enter any patient health information (PHI) into HospiceLink.
      </div>
      <div class="baa-box">
        <p><strong>Business Associate Agreement</strong></p>
        <p>This Business Associate Agreement ("BAA") is entered into between We Market Plus LLC ("Business Associate") and the subscribing organization ("Covered Entity") pursuant to the Health Insurance Portability and Accountability Act of 1996 (HIPAA) and its implementing regulations at 45 CFR Parts 160 and 164.</p>
        <p><strong>1. Definitions.</strong> Terms used but not otherwise defined shall have the same meaning as those terms in 45 CFR Parts 160 and 164.</p>
        <p><strong>2. Obligations of Business Associate.</strong> We Market Plus LLC agrees to: (a) Not use or disclose PHI other than as permitted by this BAA or as required by law; (b) Use appropriate safeguards and implement HIPAA Security Rule requirements to prevent unauthorized use or disclosure of PHI; (c) Report any unauthorized use or disclosure to Covered Entity within 60 calendar days of discovery; (d) Ensure that any subcontractors who create, receive, maintain, or transmit PHI agree to the same restrictions; (e) Make available PHI necessary to satisfy Covered Entity obligations under 45 CFR 164.524; (f) Return or destroy all PHI at termination of this Agreement.</p>
        <p><strong>3. Permitted Uses.</strong> Business Associate may use or disclose PHI as necessary to provide the HospiceLink CRM services, and as required by law.</p>
        <p><strong>4. Term and Termination.</strong> This BAA is effective upon electronic signature and terminates when all PHI is returned or destroyed, or upon termination of the underlying service agreement.</p>
        <p><strong>5. Miscellaneous.</strong> This BAA is governed by the laws of the State of Texas. It shall be amended only in writing. The parties agree that an electronic signature constitutes a legally binding signature for purposes of this Agreement.</p>
      </div>
      <div class="field">
        <label>Your Full Legal Name (Electronic Signature) *</label>
        <input type="text" id="signerName" placeholder="Jane Smith" autocomplete="name">
        <p style="font-size:11px;color:#6b7fa3;margin-top:5px">By entering your name, you electronically sign this BAA on behalf of your organization.</p>
      </div>
      <div class="agree-row">
        <input type="checkbox" id="agreeCk">
        <div class="agree-text">I have read and agree to the Business Associate Agreement above, the <a href="tos.html" target="_blank">Terms of Service</a>, and the <a href="privacy.html" target="_blank">Privacy Policy</a>.</div>
      </div>
      <hr style="border-color:rgba(255,255,255,.07);margin:20px 0">
      <div class="card-title" style="font-size:16px;margin-bottom:6px">Set Your Password</div>
      <div class="field">
        <label>Password *</label>
        <input type="password" id="newPass" placeholder="Create a strong password" oninput="checkStrength(this.value)" autocomplete="new-password">
        <div class="strength" id="strBar"></div>
      </div>
      <div class="field">
        <label>Confirm Password *</label>
        <input type="password" id="confPass" placeholder="Re-enter your password" autocomplete="new-password">
      </div>
      <button class="btn-main" id="submitBtn" onclick="activate()">Sign BAA and Activate Account</button>
    </div>
    <div class="success-box" id="successBox">
      <p style="font-size:40px;margin-bottom:12px">&#x2705;</p>
      <h3 style="color:#4fc87a;font-size:18px;margin-bottom:8px">Account Activated!</h3>
      <p style="font-size:13px;color:#8b9fc4;margin-bottom:6px">Your BAA is signed and your account is ready.</p>
      <p style="font-size:13px;color:#8b9fc4;margin-bottom:20px">Redirecting to login...</p>
      <div id="countdown" style="color:#4fa3e3;font-weight:700;font-size:13px"></div>
    </div>
  </div>
</div>
<script>
const BACKEND  = 'https://api.wemarketplus.com';
var urlParams  = new URLSearchParams(window.location.search);
var inviteToken = urlParams.get('token');
var tenantId    = urlParams.get('tenant');

if (!inviteToken || !tenantId) {
  document.getElementById('formSection').style.display = 'none';
  document.getElementById('invalidBox').style.display = 'block';
}

function checkStrength(v) {
  var bar = document.getElementById('strBar');
  bar.className = 'strength';
  if (!v) return;
  var strong = v.length >= 10 && /[A-Z]/.test(v) && /[0-9]/.test(v) && /[^a-zA-Z0-9]/.test(v);
  var mid    = v.length >= 8  && (/[A-Z]/.test(v) || /[0-9]/.test(v));
  if (strong) bar.classList.add('str-strong');
  else if (mid) bar.classList.add('str-mid');
  else bar.classList.add('str-weak');
}

function activate() {
  var signer = document.getElementById('signerName').value.trim();
  var agreed = document.getElementById('agreeCk').checked;
  var pw     = document.getElementById('newPass').value;
  var conf   = document.getElementById('confPass').value;
  var btn    = document.getElementById('submitBtn');
  var errEl  = document.getElementById('errMsg');
  errEl.style.display = 'none';

  if (!signer || signer.length < 2) { errEl.textContent = 'Please enter your full legal name to sign the BAA.'; errEl.style.display = 'block'; return; }
  if (!agreed) { errEl.textContent = 'You must agree to the BAA, Terms of Service, and Privacy Policy.'; errEl.style.display = 'block'; return; }
  if (pw.length < 8) { errEl.textContent = 'Password must be at least 8 characters.'; errEl.style.display = 'block'; return; }
  if (pw !== conf) { errEl.textContent = 'Passwords do not match.'; errEl.style.display = 'block'; return; }

  btn.textContent = 'Activating...';
  btn.disabled = true;

  fetch(BACKEND + '/api/baa/sign', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ token: inviteToken, tenant_id: tenantId, signer_name: signer, password: pw }),
  })
  .then(function(r) { return r.json(); })
  .then(function(d) {
    if (d.error) {
      if (d.error.toLowerCase().includes('expired') || d.error.toLowerCase().includes('invalid')) {
        document.getElementById('formSection').style.display = 'none';
        document.getElementById('invalidBox').style.display = 'block';
      } else {
        errEl.textContent = d.error;
        errEl.style.display = 'block';
        btn.textContent = 'Sign BAA and Activate Account';
        btn.disabled = false;
      }
      return;
    }
    document.getElementById('formSection').style.display = 'none';
    document.getElementById('successBox').style.display = 'block';
    var secs = 4;
    var cd = document.getElementById('countdown');
    var iv = setInterval(function() {
      cd.textContent = 'Redirecting in ' + secs + ' second' + (secs !== 1 ? 's' : '') + '...';
      if (secs-- <= 0) { clearInterval(iv); window.location.href = 'login.html'; }
    }, 1000);
  })
  .catch(function() {
    errEl.textContent = 'Connection error. Please try again.';
    errEl.style.display = 'block';
    btn.textContent = 'Sign BAA and Activate Account';
    btn.disabled = false;
  });
}
</script>
</body>
</html>
