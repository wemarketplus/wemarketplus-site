# Base URL of the wemarketplus-backend (NestJS) API.
# In dev, Vite proxies /api -> this URL (see vite.config.ts), so leaving the
# default lets you call routes like `/auth/login` from the client and have
# them reach the backend at http://localhost:3000/auth/login.
VITE_API_BASE_URL=/api

# App display name (used in <title>, login screen, etc.)
VITE_APP_NAME=WeMarketPlus
