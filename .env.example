# Base path the client calls. In dev, Vite proxies /api -> the backend origin
# below WITHOUT striping the prefix, so /api/auth/login reaches the NestJS
# backend at <VITE_BACKEND_ORIGIN>/api/auth/login (the backend mounts every
# route under its own `app.setGlobalPrefix('api')`).
VITE_API_BASE_URL=/api

# Origin of the wemarketplus-backend (NestJS) for the dev proxy. The backend
# PORT defaults to 3000 but is set to 4200 in some environments — match it here.
VITE_BACKEND_ORIGIN=http://localhost:3000

# App display name (used in <title>, login screen, etc.)
VITE_APP_NAME=WeMarketPlus

# Map tiles for the location picker on Mileage's From/To fields.
#
# LEAVE BLANK and the picker uses OpenStreetMap's own tiles: no key, no account.
# OSM's tile policy forbids heavy or commercial traffic, so a deployment with a
# real field team points this at its own provider, key included — tiles are
# <img> requests, so this key IS public by nature. Restrict it by HTTP referrer
# in the provider's console; it is not a secret and must not be treated as one.
# (The GEOCODER_API_KEY that pairs with it lives in the BACKEND env, where it
# stays server-side.)
#   VITE_MAP_TILE_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=XXXX
#   VITE_MAP_ATTRIBUTION=© MapTiler © OpenStreetMap contributors
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=
