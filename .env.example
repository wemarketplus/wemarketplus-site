# Base path the client calls. In dev, Vite proxies /api -> the backend origin
# below WITHOUT striping the prefix, so /api/auth/login reaches the NestJS
# backend at <VITE_BACKEND_ORIGIN>/api/auth/login (the backend mounts every
# route under its own `app.setGlobalPrefix('api')`).
VITE_API_BASE_URL=/api

# Origin of the wemarketplus-backend (NestJS) for the dev proxy. The backend
# PORT defaults to 3000 but is set to 4200 in some environments — match it here.
VITE_BACKEND_ORIGIN=http://localhost:3000

# App display name (used in <title>, login screen, etc.)
VITE_APP_NAME=WeMarketPlus
