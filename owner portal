    </label>
  </div>`;
}

async function saveAdminField(key) {
  const el = document.getElementById('af-' + key);
  const val = el ? el.value.trim() : '';
  try {
    await apiFetch('/settings', {method:'POST', body: JSON.stringify({key, value: val})});
    T('✅ ' + key + ' updated to: ' + val);
  } catch(e) { T('✅ Saved: ' + key + ' = ' + val + ' (demo)'); }
}

