        <div style="display:flex;gap:6px;flex-wrap:wrap">
          <button class="btn btn-x btn-sm" onclick="T('Edit ${p} settings')">Edit</button>
          <button class="btn btn-x btn-sm" onclick="T('View ${p} Stripe links')">Stripe</button>
        </div>
      </div>`).join('')}
    </div>
  </div>`;
}

function buildAdminField(label, current, key) {
  return `<div>
    <div style="font-size:11px;font-weight:700;color:var(--text3);margin-bottom:4px">${h(label)}</div>
    <div style="display:flex;gap:8px;align-items:center">
