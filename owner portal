// HELPERS
// ════════════════════════════════════════════════════════════════
function h(s) { if (!s && s !== 0) return ''; return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
function $$(n, val) { return val !== undefined ? (n >= 1000 ? '$' + (n/1000).toFixed(1) + 'k' : '$' + n) : n; }
function fmt$(n) { return '$' + Number(n||0).toLocaleString(); }
function fmtDate(d) { return d ? new Date(d).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'}) : '—'; }
function fmtRel(d) {
  if (!d) return '—';
  const diff = Date.now() - new Date(d).getTime();
  const days = Math.floor(diff / 86400000);
  return days === 0 ? 'Today' : days === 1 ? 'Yesterday' : days + 'd ago';
}
function riskClass(score) { return score >= 70 ? 'risk-high' : score >= 40 ? 'risk-med' : 'risk-low'; }
function riskLabel(score) { return score >= 70 ? 'High Risk' : score >= 40 ? 'Medium' : 'Healthy'; }

function sparkBars(data) {
  if (!data || !data.length) return '';
  const max = Math.max(...data, 1);
  return '<div class="sparkline">' +
    data.map(v => `<div class="spark-bar" style="height:${Math.round((v/max)*32)}px;flex:1" title="${v}"></div>`).join('') +
  '</div>';
}

function badge(text, cls) { return `<span class="badge ${cls}">${h(text)}</span>`; }

function statusBadge(status) {
  const map = {
    active:'bg', trial:'bb', past_due:'br', canceled:'br',
    at_risk:'ba', suspended:'br', healthy:'bg', churned:'br'
  };
  return badge(status, map[status?.toLowerCase()] || 'bb');
}

function offlineView(page, err) {
  return `<div style="background:var(--card);border:1px solid rgba(248,113,113,.2);border-radius:14px;padding:40px;text-align:center">
    <div style="font-size:32px;margin-bottom:12px">⚠️</div>
    <div style="font-size:16px;font-weight:800;color:var(--text1);margin-bottom:8px">Backend Offline</div>
    <div style="color:var(--text3);font-size:13px;margin-bottom:20px">Could not load ${page} data. Showing demo metrics.</div>
    <div style="font-size:11px;color:rgba(248,113,113,.8)">${h(err||'Connection refused')}</div>
    <div style="margin-top:20px"><button class="btn btn-x" onclick="renderPage('${page}')">↻ Retry</button></div>
  </div>` + getDemoFallback(page);
}

