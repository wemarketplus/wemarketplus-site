*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%;font-family:'Segoe UI',Arial,sans-serif;background:#060e1a;color:#f4f8ff}
a{text-decoration:none;color:inherit}
/* Spinner */
@keyframes spin{to{transform:rotate(360deg)}}
.spinner{width:32px;height:32px;border:4px solid #1e3a5f;border-top:4px solid #ffd700;border-radius:50%;animation:spin 1s linear infinite}
/* Login Screen */
#loginScreen{min-height:100vh;display:flex;align-items:center;justify-content:center;background:#060e1a}
.login-box{text-align:center;padding:40px;background:#0d1b31;border:1px solid rgba(255,215,0,.25);border-radius:20px;width:340px}
.login-icon{font-size:52px;margin-bottom:12px}
.login-title{color:#ffd700;font-size:20px;font-weight:900;margin-bottom:6px}
.login-sub{color:#8b949e;font-size:13px;margin-bottom:20px}
.login-input{width:100%;padding:11px 14px;border-radius:10px;border:1px solid rgba(255,215,0,.3);background:#081426;color:#f4f8ff;font-size:14px;font-family:inherit;outline:none;margin-bottom:10px}
.login-input.err{border:2px solid #ef4444}
.login-err{color:#ef4444;font-size:12px;margin:0 0 10px}
.login-btn{width:100%;padding:11px 0;border-radius:10px;border:none;background:#ffd700;color:#081426;font-weight:900;font-size:14px;cursor:pointer;font-family:inherit}
.login-btn:hover{opacity:.9}
/* Main App */
#app{display:none;flex-direction:column;min-height:100vh}
.mock-banner{background:rgba(245,158,11,.1);border-bottom:1px solid rgba(245,158,11,.4);padding:8px 28px;display:flex;align-items:center;gap:10px}
.mock-banner span{color:#f59e0b;font-size:13px;font-weight:800}
.hdr{background:linear-gradient(90deg,#0a1628,#0d1e38);border-bottom:2px solid rgba(255,215,0,.25);padding:18px 28px;display:flex;justify-content:space-between;align-items:center}
.hdr-left .company{font-size:20px;font-weight:900;color:#ffd700}
.hdr-left .sub{font-size:12px;color:#8b949e;margin-top:2px}
.hdr-right{display:flex;gap:20px;align-items:center}
.hdr-stat .lbl{font-size:11px;color:#8b949e;text-align:right}
.hdr-stat .val{font-size:22px;font-weight:900;text-align:right}
.hdr-logout{background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.15);color:#8b949e;border-radius:999px;padding:6px 14px;font-size:12px;font-weight:700;cursor:pointer;font-family:inherit}
/* KPI Bar */
.kpi-bar{background:#081426;border-bottom:1px solid rgba(255,255,255,.07);padding:12px 28px}
.kpi-bar-inner{display:flex;gap:28px;flex-wrap:wrap;max-width:1400px;margin:0 auto}
.kpi-bar-item .kpi-lbl{font-size:10px;font-weight:800;color:#8b949e;text-transform:uppercase}
.kpi-bar-item .kpi-val{font-size:18px;font-weight:900}
/* Tab Nav */
.tab-nav{background:#081426;padding:10px 28px;border-bottom:1px solid rgba(255,255,255,.07);display:flex;gap:6px;flex-wrap:wrap;overflow-x:auto}
.tab-btn{border:none;border-radius:999px;padding:8px 18px;font-weight:800;font-size:12px;cursor:pointer;font-family:inherit;transition:.1s;border-bottom:2px solid transparent}
.tab-btn.active{background:rgba(255,215,0,.2);color:#ffd700;border-bottom-color:#ffd700}
.tab-btn:not(.active){background:rgba(255,255,255,.06);color:#8b949e}
.tab-btn:not(.active):hover{background:rgba(255,255,255,.1);color:#f4f8ff}
/* Content */
.content{max-width:1400px;margin:0 auto;padding:24px 20px}
/* Cards */
.card{background:#0d1b31;border:1px solid rgba(255,255,255,.1);border-radius:16px;padding:18px;margin-bottom:14px}
.gold-card{background:linear-gradient(135deg,#14100a,#1a1400);border:1px solid rgba(255,215,0,.3);border-radius:16px;padding:18px;margin-bottom:14px}
/* KPI Grid */
.kpi-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:12px;margin-bottom:20px}
.kpi-item{border-radius:14px;padding:14px 12px;text-align:center}
.kpi-item .k-lbl{font-size:10px;font-weight:800;text-transform:uppercase;margin:0 0 4px}
.kpi-item .k-val{font-size:20px;font-weight:900;margin:0;line-height:1}
.kpi-item .k-sub{font-size:10px;color:#8b949e;margin:3px 0 0}
/* Section header */
.sec-h{margin-bottom:14px}
.sec-h h3{margin:0;color:#ffd700;font-size:16px;font-weight:900}
.sec-h p{margin:3px 0 0;color:#8b949e;font-size:12px}
/* Tables */
.tbl-wrap{overflow-x:auto}
table.portal-tbl{width:100%;border-collapse:collapse}
.portal-tbl th{background:#0a1628;font-size:10px;text-transform:uppercase;letter-spacing:.04em;font-weight:800;padding:9px 12px;text-align:left;color:#8b949e;border-bottom:1px solid rgba(255,255,255,.07)}
.portal-tbl td{padding:10px 12px;border-bottom:1px solid rgba(255,255,255,.05);font-size:12px;color:#c7d3e8}
.portal-tbl tr:hover td{background:rgba(255,255,255,.02)}
.portal-tbl tr.detail-row td{padding:16px 20px;background:rgba(255,215,0,.03);border-left:3px solid #ffd700}
/* Pills */
.pill{display:inline-block;padding:3px 10px;border-radius:999px;font-size:11px;font-weight:800}
/* Buttons */
.pbtn{border:none;border-radius:999px;padding:6px 14px;font-weight:800;font-size:11px;cursor:pointer;font-family:inherit;transition:.1s}
.pbtn:hover{opacity:.85}
.pbtn-gold{background:#ffd700;color:#081426}
.pbtn-green{background:#22c55e;color:#081426}
.pbtn-red{background:rgba(239,68,68,.2);color:#ef4444}
.pbtn-default{background:rgba(255,255,255,.08);color:#f4f8ff}
/* Tier cards */
.tier-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-bottom:16px}
.tier-card{border-radius:14px;padding:16px;text-align:center}
/* Risk/churn rows */
.risk-row{border-radius:12px;padding:14px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px;margin-bottom:10px}
/* Alert rows */
.alert-row{border-radius:10px;padding:11px 16px;display:flex;justify-content:space-between;align-items:center;margin-bottom:8px}
/* Task rows */
.task-row{border-radius:12px;padding:12px 16px;display:flex;justify-content:space-between;align-items:center;margin-bottom:8px}
/* Insight cards */
.insight-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:12px}
.insight-card{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08);border-radius:12px;padding:14px;display:flex;gap:12px;align-items:center}
/* Score bar */
.score-bar{display:inline-block;width:60px;height:6px;border-radius:3px;background:rgba(255,255,255,.1);vertical-align:middle;overflow:hidden;margin-left:5px}
.score-fill{height:100%;border-radius:3px}
/* Lead detail */
.lead-detail-meta{display:flex;gap:20px;flex-wrap:wrap;font-size:12px;color:#c7d3e8;margin-bottom:16px;padding:10px 14px;background:rgba(255,255,255,.04);border-radius:10px}
.ev-row{display:flex;align-items:flex-start;gap:12px;padding:8px 12px;border-radius:8px;margin-bottom:4px}
/* Promo / settings forms */
.settings-section{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px}
