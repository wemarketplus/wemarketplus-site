function buildChurnHTML(customers) {
  const atRisk = customers.filter(c => (c.risk||0) >= 40).sort((a,b) => (b.risk||0) - (a.risk||0));
  document.getElementById('riskCount').textContent = atRisk.length || '';
  return `
  <div class="kpi-grid">
    <div class="kpi"><div class="kpi-label">High Risk (70+)</div><div class="kpi-val kpi-down">${customers.filter(c=>(c.risk||0)>=70).length}</div><div class="kpi-sub">Immediate action needed</div></div>
    <div class="kpi"><div class="kpi-label">Medium Risk (40–69)</div><div class="kpi-val kpi-warn">${customers.filter(c=>(c.risk||0)>=40&&(c.risk||0)<70).length}</div><div class="kpi-sub">Watch closely</div></div>
    <div class="kpi"><div class="kpi-label">Healthy (0–39)</div><div class="kpi-val kpi-up">${customers.filter(c=>(c.risk||0)<40).length}</div></div>
  </div>
  <div class="card">
    <div class="card-h"><div class="card-t">At-Risk Accounts</div><div class="card-sub">Sorted by risk score — highest first</div></div>
    <div class="tbl-wrap">
    <table class="tbl">
      <thead><tr><th>Company</th><th>Product</th><th>Risk Score</th><th>Risk Factors</th><th>Last Login</th><th>Payment</th><th>Action</th></tr></thead>
      <tbody>
        ${customers.sort((a,b) => (b.risk||0) - (a.risk||0)).map(c => `<tr>
          <td><div style="font-weight:700;color:var(--text1)">${h(c.company)}</div><div style="font-size:10px;color:var(--text3)">${h(c.contact)}</div></td>
          <td style="font-size:11px">${h(c.product)}</td>
          <td>
            <div class="prog-bar" style="width:100px;margin-bottom:4px"><div class="prog-fill" style="width:${c.risk||0}%;background:${(c.risk||0)>=70?'var(--red)':(c.risk||0)>=40?'var(--amber)':'var(--green)'}"></div></div>
            <span class="risk-badge ${riskClass(c.risk||0)}">${riskLabel(c.risk||0)} (${c.risk||0})</span>
          </td>
          <td style="font-size:11px;color:var(--text3)">${getRiskFactors(c)}</td>
          <td style="font-size:11px;color:var(--text3)">${fmtRel(c.last_login)}</td>
          <td>${statusBadge(c.payment_status)}</td>
          <td><button class="btn btn-x btn-sm" onclick="addRiskNote('${h(c.company)}')">Add Note</button></td>
        </tr>`).join('')}
      </tbody>
    </table>
    </div>
  </div>`;
}

function getRiskFactors(c) {
  const factors = [];
  if (c.payment_status === 'failed') factors.push('Failed payment');
  if (c.status === 'past_due') factors.push('Past due');
  if (c.status === 'trial') factors.push('Trial — not converted');
  const days = c.last_login ? Math.floor((Date.now() - new Date(c.last_login).getTime()) / 86400000) : 999;
  if (days > 30) factors.push(`No login ${days}d`);
  else if (days > 14) factors.push(`Low activity ${days}d`);
  return factors.length ? factors.join(', ') : 'Healthy';
}

function addRiskNote(company) { T('Note added for ' + company); }
function updateRiskCount() {
  const el = document.getElementById('riskCount');
  if (el) el.textContent = DEMO.customers.filter(c => (c.risk||0) >= 40).length || '';
}

