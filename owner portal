function toggleTask(i){
  var idx = doneTasks.indexOf(i);
  if(idx === -1) doneTasks.push(i);
  else doneTasks.splice(idx, 1);
  renderTab('Tasks');
}

// ─── ALERTS ───────────────────────────────────────────────────
function renderAlerts(){
  var html = '<div class="sec-h"><h3>🔔 Smart Alerts</h3><p>Real-time notifications — never miss a money moment</p></div>';
  var colors = {success:'#22c55e', warning:'#f59e0b', info:'#49b6ff', danger:'#ef4444'};
  var bgs = {success:'rgba(34,197,94,.08)', warning:'rgba(245,158,11,.08)', info:'rgba(73,182,255,.08)', danger:'rgba(239,68,68,.08)'};
  var borders = {success:'rgba(34,197,94,.25)', warning:'rgba(245,158,11,.25)', info:'rgba(73,182,255,.25)', danger:'rgba(239,68,68,.25)'};
  ALERTS.forEach(function(a){
    html += '<div class="alert-row" style="background:'+bgs[a.type]+';border:1px solid '+borders[a.type]+'">'
      +'<span style="color:'+colors[a.type]+';font-size:13px;font-weight:700">'+a.msg+'</span>'
      +'<span style="color:#8b949e;font-size:11px">'+a.time+'</span>'
    +'</div>';
  });
  return html;
}

// ─── SETTINGS ─────────────────────────────────────────────────
function renderSettings(){
  var html = '<div class="sec-h"><h3>⚙️ Administrative Controls</h3><p>Owner-level settings, promo codes, and global constants</p></div>';
  html += '<div class="settings-section">';
  // Revenue Constants
  html += '<div class="setting-card"><h4>💰 Global Revenue Constants</h4>'
    +'<div class="setting-row"><label>Revenue Per Admit ($)</label><input type="number" id="setRevAdmit" value="'+adminSettings.revenuePerAdmit+'" style=""></div>'
    +'<div class="setting-row"><label>Monthly Marketing Cost ($)</label><input type="number" id="setMktCost" value="'+adminSettings.marketingCost+'"></div>'
    +'<div class="setting-row"><label>Setup Fee ($)</label><input type="number" id="setSetupFee" value="'+adminSettings.setupFee+'"></div>'
    +'<button class="pbtn pbtn-gold" onclick="saveSettings()">💾 Save Constants</button>'
    +'</div>';
  // Promo Generator
  html += '<div class="setting-card"><h4>🎟 Promo Code Generator</h4>'
    +'<div class="setting-row"><label>Code</label><input type="text" id="promoCode" placeholder="e.g. LAUNCH50" style="text-transform:uppercase"></div>'
    +'<div class="setting-row"><label>Discount Type</label><select id="promoType"><option value="percent">Percentage (%)</option><option value="fixed">Fixed Amount ($)</option></select></div>'
    +'<div class="setting-row"><label>Discount Value</label><input type="number" id="promoValue" placeholder="e.g. 50"></div>'
    +'<div class="setting-row"><label>Applies To</label><select id="promoApplies"><option>All Plans</option><option>Pro Only</option><option>Max Only</option><option>Gold Only</option><option>Setup Fee Only</option></select></div>'
    +'<div class="setting-row"><label>Expiry Date</label><input type="date" id="promoExpiry"></div>'
    +'<button class="pbtn pbtn-gold" onclick="createPromo()">➕ Create Promo Code</button>'
    +'</div>';
  html += '</div>';
  // Active Promo Codes
  if(promosList.length > 0){
    html += '<div class="gold-card"><h4 style="color:#ffd700;margin:0 0 12px">Active Promo Codes</h4>';
    html += '<div class="tbl-wrap"><table class="portal-tbl"><thead><tr><th>Code</th><th>Type</th><th>Value</th><th>Applies To</th><th>Expiry</th><th>Uses</th><th>Action</th></tr></thead><tbody>';
    promosList.forEach(function(p, i){
      html += '<tr>'
        +'<td><strong style="color:#ffd700;font-family:monospace">'+p.code+'</strong></td>'
        +'<td>'+p.type+'</td>'
        +'<td>'+(p.type==='percent'?p.value+'%':'$'+p.value)+'</td>'
        +'<td>'+p.applies+'</td>'
        +'<td>'+p.expiry+'</td>'
        +'<td>'+p.uses+' uses</td>'
        +'<td>'+btn('Delete','pbtn-red',"deletePromo("+i+")")+'</td>'
      +'</tr>';
    });
    html += '</tbody></table></div></div>';
  }
  // Stripe Config
  html += '<div class="card"><h4 style="color:#fff;margin:0 0 14px">🔗 Stripe Integration</h4>'
    +'<div class="settings-section">'
    +'<div><div class="setting-row"><label>Stripe Secret Key (server-side only)</label><input type="password" placeholder="sk_live_..." value=""></div>'
    +'<div class="setting-row"><label>Stripe Webhook Secret</label><input type="password" placeholder="whsec_..." value=""></div></div>'
    +'<div><div class="setting-row"><label>Webhook Events to Monitor</label><select><option>payment_intent.succeeded</option><option>customer.subscription.deleted</option><option>invoice.payment_failed</option></select></div>'
    +'<div class="setting-row"><label>Auto-suspend on Failed Payment</label><select><option>After 3 failures</option><option>After 1 failure</option><option>After 7 days past due</option></select></div></div>'
    +'</div>'
    +'<button class="pbtn pbtn-gold" onclick="T(\'Stripe settings saved! Note: connect backend to enable real-time data.\',\'i\')">💾 Save Stripe Config</button>'
    +'</div>';
  return html;
}
function saveSettings(){
  var ra = document.getElementById('setRevAdmit');
  var mc = document.getElementById('setMktCost');
  var sf = document.getElementById('setSetupFee');
  if(ra && mc && sf){
    adminSettings = {revenuePerAdmit:+ra.value, marketingCost:+mc.value, setupFee:+sf.value};
    localStorage.setItem('wmp_settings', JSON.stringify(adminSettings));
    T('Constants saved!');
  }
}
function createPromo(){
  var code = document.getElementById('promoCode');
  var type = document.getElementById('promoType');
  var val = document.getElementById('promoValue');
  var applies = document.getElementById('promoApplies');
  var expiry = document.getElementById('promoExpiry');
  if(!code||!code.value.trim()||!val||!val.value){T('Please fill in all promo fields.','e');return;}
  promosList.push({code:code.value.toUpperCase().trim(), type:type.value, value:val.value, applies:applies.value, expiry:expiry.value||'No expiry', uses:0});
  localStorage.setItem('wmp_promos', JSON.stringify(promosList));
  T('Promo code '+code.value.toUpperCase()+' created!');
  renderTab('Settings');
}
function deletePromo(i){
  if(confirm('Delete promo code '+promosList[i].code+'?')){
    promosList.splice(i,1);
    localStorage.setItem('wmp_promos', JSON.stringify(promosList));
    T('Promo code deleted.','w');
    renderTab('Settings');
  }
}
</script>
</body>
</html>
