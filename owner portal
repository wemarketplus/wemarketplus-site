function T(msg, type){
  var c = document.createElement('div');
  type = type || 's';
  var colors = {s:'#8cff66', e:'#f87171', w:'#fbbf24', i:'#79c0ff'};
  var borders = {s:'rgba(140,255,102,.4)', e:'rgba(239,68,68,.4)', w:'rgba(251,191,36,.4)', i:'rgba(73,182,255,.4)'};
  c.style.cssText = 'position:fixed;bottom:20px;right:20px;z-index:9999;background:#0d1b31;border:1px solid '+borders[type]+';border-radius:9px;padding:11px 18px;font-size:13px;color:'+colors[type]+';font-weight:700;font-family:inherit;box-shadow:0 4px 18px rgba(0,0,0,.5);animation:tin .18s ease;max-width:360px';
  c.textContent = msg;
  var style = document.createElement('style');
  style.textContent = '@keyframes tin{from{opacity:0;transform:translateX(16px)}to{opacity:1;transform:none}}';
  document.head.appendChild(style);
  document.body.appendChild(c);
  setTimeout(function(){if(c.parentNode)c.parentNode.removeChild(c);}, 3000);
}

// ─── TABS ─────────────────────────────────────────────────────
var TABS = ['Revenue','Pipeline','Visitors','Subscriptions','Churn','Marketing','Insights','Communications','Tasks','Alerts','Settings'];

function initApp(){
  // Build tab nav
  var nav = document.getElementById('tabNav');
  nav.innerHTML = TABS.map(function(t){
    return '<button class="tab-btn'+(t===currentTab?' active':'')+'" onclick="switchTab(\''+t+'\')">'+t+'</button>';
  }).join('');
  renderTab(currentTab);
}
function switchTab(name){
  currentTab = name;
  document.querySelectorAll('.tab-btn').forEach(function(b){
    b.classList.toggle('active', b.textContent === name);
  });
  renderTab(name);
}
function renderTab(name){
  var c = document.getElementById('content');
  if(name==='Revenue') c.innerHTML = renderRevenue();
  else if(name==='Pipeline') c.innerHTML = renderPipeline();
  else if(name==='Visitors') c.innerHTML = renderVisitors();
  else if(name==='Subscriptions') c.innerHTML = renderSubscriptions();
  else if(name==='Churn') c.innerHTML = renderChurn();
  else if(name==='Marketing') c.innerHTML = renderMarketing();
  else if(name==='Insights') c.innerHTML = renderInsights();
  else if(name==='Communications') c.innerHTML = renderCommunications();
  else if(name==='Tasks') c.innerHTML = renderTasks();
  else if(name==='Alerts') c.innerHTML = renderAlerts();
  else if(name==='Settings') c.innerHTML = renderSettings();
}

