<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>We Market Plus — Owner's Portal</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#04080f;--card:#080f1d;--card2:#0a1628;
  --border:rgba(255,255,255,.07);--border2:rgba(255,255,255,.04);
  --text1:#f4f8ff;--text2:#c0cce0;--text3:#6b7fa3;
  --green:#4fc87a;--amber:#f59e0b;--red:#f87171;--blue:#3d9ee8;--purple:#a78bfa;
  --green-bg:rgba(79,200,122,.1);--amber-bg:rgba(245,158,11,.1);
  --red-bg:rgba(248,113,113,.1);--blue-bg:rgba(61,158,232,.1);
  --sidebar:220px;
}
body{background:var(--bg);color:var(--text1);font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;font-size:14px;line-height:1.5}

/* ── Login Screen ─────────────────────────────────────────── */
#loginScreen{position:fixed;inset:0;background:var(--bg);display:flex;align-items:center;justify-content:center;z-index:9999}
.login-box{background:var(--card);border:1px solid rgba(245,158,11,.3);border-radius:18px;padding:40px;width:100%;max-width:400px;text-align:center}
.login-logo{font-size:32px;margin-bottom:8px}
.login-title{font-size:22px;font-weight:900;color:var(--text1);margin-bottom:4px}
.login-sub{font-size:13px;color:var(--text3);margin-bottom:28px}
.login-field{display:flex;flex-direction:column;gap:4px;margin-bottom:14px;text-align:left}
.login-field label{font-size:11px;font-weight:700;color:var(--text3);text-transform:uppercase;letter-spacing:.06em}
.login-field input{background:#060e1b;border:1px solid rgba(255,255,255,.1);border-radius:8px;padding:10px 12px;color:var(--text1);font-size:14px;font-family:inherit;outline:none;transition:border-color .12s}
.login-field input:focus{border-color:var(--amber)}
.btn-login{width:100%;background:var(--amber);color:#06080e;border:none;border-radius:999px;padding:12px;font-size:14px;font-weight:900;cursor:pointer;font-family:inherit;margin-top:8px;transition:opacity .1s}
.btn-login:hover{opacity:.85}
#loginError{color:var(--red);font-size:12px;margin-top:8px;display:none}
.login-private{font-size:11px;color:var(--text3);margin-top:16px}

/* ── App Layout ───────────────────────────────────────────── */
#app{display:none;height:100vh;flex-direction:row;overflow:hidden}

/* ── Sidebar ──────────────────────────────────────────────── */
.sidebar{width:var(--sidebar);background:var(--card);border-right:1px solid var(--border);display:flex;flex-direction:column;flex-shrink:0;overflow-y:auto}
.sb-logo{padding:18px 16px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:10px}
.sb-logo-icon{width:32px;height:32px;background:var(--amber);border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:16px;flex-shrink:0}
.sb-logo-text{font-size:12px;font-weight:800;color:var(--text1);line-height:1.2}
.sb-logo-sub{font-size:10px;color:var(--text3);font-weight:400}
.sb-sec{padding:14px 12px 4px;font-size:9px;font-weight:900;letter-spacing:.12em;text-transform:uppercase;color:var(--text3)}
.sb-btn{display:flex;align-items:center;gap:10px;padding:9px 14px;border-radius:8px;margin:1px 8px;cursor:pointer;font-size:12px;font-weight:600;color:var(--text2);transition:background .1s;border:none;background:none;font-family:inherit;width:calc(100% - 16px);text-align:left}
.sb-btn:hover{background:rgba(255,255,255,.04);color:var(--text1)}
.sb-btn.active{background:rgba(245,158,11,.12);color:var(--amber);font-weight:700}
.sb-btn .sb-icon{width:18px;text-align:center;font-size:14px;flex-shrink:0}
.sb-badge{margin-left:auto;background:var(--red);color:#fff;border-radius:999px;padding:1px 6px;font-size:10px;font-weight:900}
.sb-bottom{margin-top:auto;padding:12px 8px;border-top:1px solid var(--border)}
.sb-user{display:flex;align-items:center;gap:8px;padding:8px}
.sb-avatar{width:28px;height:28px;background:var(--amber);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:900;color:#06080e;flex-shrink:0}

/* ── Main ─────────────────────────────────────────────────── */
.main{flex:1;overflow-y:auto;background:var(--bg)}
.topbar{background:var(--card);border-bottom:1px solid var(--border);padding:12px 24px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:100}
.topbar-title{font-size:16px;font-weight:800;color:var(--text1)}
.topbar-right{display:flex;align-items:center;gap:10px}
.content{padding:20px 24px}

/* ── Cards ────────────────────────────────────────────────── */
.card{background:var(--card);border:1px solid var(--border);border-radius:14px;padding:18px;margin-bottom:14px}
.card-h{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px}
.card-t{font-size:13px;font-weight:800;color:var(--text1)}
.card-sub{font-size:11px;color:var(--text3);margin-top:2px}

/* ── KPI Grid ─────────────────────────────────────────────── */
.kpi-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:12px;margin-bottom:18px}
.kpi{background:var(--card);border:1px solid var(--border);border-radius:12px;padding:14px;cursor:pointer;transition:border-color .12s}
.kpi:hover{border-color:rgba(255,255,255,.15)}
.kpi-label{font-size:11px;font-weight:700;color:var(--text3);text-transform:uppercase;letter-spacing:.05em;margin-bottom:4px}
.kpi-val{font-size:26px;font-weight:900;color:var(--text1);line-height:1;margin-bottom:4px}
.kpi-sub{font-size:11px;color:var(--text3)}
.kpi-up{color:var(--green)}
.kpi-down{color:var(--red)}
.kpi-warn{color:var(--amber)}

/* ── Tables ───────────────────────────────────────────────── */
.tbl-wrap{overflow-x:auto}
table.tbl{width:100%;border-collapse:collapse;font-size:12px}
table.tbl th{text-align:left;padding:8px 10px;font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.06em;color:var(--text3);border-bottom:1px solid var(--border)}
table.tbl td{padding:10px 10px;border-bottom:1px solid var(--border2);color:var(--text2);vertical-align:top}
table.tbl tr:hover td{background:rgba(255,255,255,.02)}

/* ── Badges ───────────────────────────────────────────────── */
.badge{display:inline-flex;align-items:center;border-radius:999px;padding:2px 9px;font-size:10px;font-weight:800;white-space:nowrap}
.bg{background:var(--green-bg);color:var(--green)}
.ba{background:var(--amber-bg);color:var(--amber)}
.br{background:var(--red-bg);color:var(--red)}
.bb{background:var(--blue-bg);color:var(--blue)}
.bp{background:rgba(167,139,250,.1);color:var(--purple)}

/* ── Buttons ──────────────────────────────────────────────── */
.btn{border:none;border-radius:999px;padding:7px 16px;font-size:12px;font-weight:700;cursor:pointer;font-family:inherit;transition:opacity .1s;white-space:nowrap}
.btn:hover{opacity:.82}
.btn-a{background:var(--amber);color:#06080e}
.btn-g{background:var(--green-bg);color:var(--green);border:1px solid rgba(79,200,122,.25)}
.btn-r{background:var(--red-bg);color:var(--red);border:1px solid rgba(248,113,113,.25)}
.btn-x{background:rgba(255,255,255,.06);color:var(--text2);border:1px solid var(--border)}
.btn-sm{padding:4px 12px;font-size:11px}

/* ── Progress bars ────────────────────────────────────────── */
.prog-bar{height:6px;background:rgba(255,255,255,.06);border-radius:999px;overflow:hidden;margin-top:4px}
.prog-fill{height:100%;border-radius:999px;transition:width .4s}

/* ── Risk score ───────────────────────────────────────────── */
.risk-badge{display:inline-flex;align-items:center;border-radius:999px;padding:3px 10px;font-size:11px;font-weight:900}
.risk-low{background:rgba(79,200,122,.12);color:var(--green)}
.risk-med{background:rgba(245,158,11,.12);color:var(--amber)}
.risk-high{background:rgba(248,113,113,.12);color:var(--red)}

/* ── Tabs within pages ────────────────────────────────────── */
.page-tabs{display:flex;gap:4px;margin-bottom:18px;flex-wrap:wrap}
.pt-btn{padding:6px 14px;border-radius:999px;font-size:12px;font-weight:700;cursor:pointer;border:1px solid var(--border);background:none;color:var(--text3);font-family:inherit;transition:all .1s}
.pt-btn.active{background:var(--amber);color:#06080e;border-color:var(--amber)}

/* ── Grid layouts ─────────────────────────────────────────── */
.g2{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.g3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:14px}

/* ── Toast ────────────────────────────────────────────────── */
#opToast{position:fixed;bottom:24px;right:24px;background:#1e3a5f;border:1px solid rgba(61,158,232,.3);border-radius:10px;padding:10px 18px;font-size:13px;color:var(--text1);display:none;z-index:99999;box-shadow:0 4px 24px rgba(0,0,0,.4);max-width:340px}
#opToast.show{display:block;animation:slideIn .18s ease}
@keyframes slideIn{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}

/* ── Metrics mini chart (CSS sparkline) ────────────────────── */
.sparkline{display:flex;align-items:flex-end;gap:2px;height:32px}
.spark-bar{background:rgba(61,158,232,.3);border-radius:2px 2px 0 0;min-width:6px;transition:background .1s}
.spark-bar:hover{background:var(--blue)}

/* ── Note card ────────────────────────────────────────────── */
.note-card{background:var(--card2);border:1px solid var(--border2);border-radius:10px;padding:12px 14px;margin-bottom:8px}
.note-source{display:inline-flex;align-items:center;gap:4px;font-size:10px;font-weight:900;border-radius:4px;padding:2px 8px;margin-bottom:6px}
.ns-aircall{background:rgba(61,158,232,.15);color:var(--blue);border:1px solid rgba(61,158,232,.3)}
.ns-stripe{background:rgba(99,91,255,.15);color:#635bff;border:1px solid rgba(99,91,255,.3)}
.ns-system{background:rgba(167,139,250,.1);color:var(--purple);border:1px solid rgba(167,139,250,.3)}
.ns-manual{background:rgba(79,200,122,.1);color:var(--green);border:1px solid rgba(79,200,122,.3)}

/* ── Mobile ───────────────────────────────────────────────── */
@media(max-width:768px){
  .sidebar{display:none}
  .kpi-grid{grid-template-columns:1fr 1fr}
  .g2,.g3{grid-template-columns:1fr}
  .content{padding:14px}
}


/* ── Enhanced Mobile Styles ─────────────────────────────────── */
#mobile-nav {
  display:none;
  position:fixed;bottom:0;left:0;right:0;
  background:#0a1628;border-top:1px solid rgba(255,255,255,.08);
  z-index:1000;height:58px;
  box-shadow:0 -2px 20px rgba(0,0,0,.35);
}
.mob-nav-btn {
  flex:1;display:flex;flex-direction:column;align-items:center;
  justify-content:center;gap:2px;padding:4px 2px;
  border:none;background:none;color:#6b7fa3;
  font-size:9px;font-weight:800;cursor:pointer;font-family:inherit;
  border-top:2px solid transparent;transition:all .15s;
  text-transform:uppercase;letter-spacing:.03em;min-width:0;
}
.mob-nav-btn.active{color:#f59e0b;border-top-color:#f59e0b;background:rgba(245,158,11,.06);}
.mob-icon{font-size:19px;line-height:1;display:block;}
.mob-label{font-size:8px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;width:100%;text-align:center;}
@media(max-width:640px){
  #mobile-nav{display:flex !important;}
  .main,.sidebar+div,[class*="main"]{padding-bottom:66px !important;}
  /* Sidebar: hidden but accessible via menu */
  nav.sidebar,div.sidebar,.sidebar,#sidebar{display:none !important;}
  /* Main content: full width */
  .main{margin-left:0 !important;width:100% !important;min-width:0 !important;}
  /* Cards: better mobile padding */
  .card{padding:12px !important;border-radius:12px !important;margin-bottom:10px !important;}
  .card-h,.card-hd{flex-wrap:wrap !important;gap:8px !important;}
  /* Stats: 2-col on mobile */
  .stats,.kpi-grid{grid-template-columns:1fr 1fr !important;gap:8px !important;}
  .stat,.kpi{padding:10px 12px !important;border-radius:10px !important;}
  .sv,.kpi-val{font-size:22px !important;}
  /* Tables: scrollable */
  table{min-width:460px;}
  .tbl-wrap,.tbl-scroll{overflow-x:auto !important;-webkit-overflow-scrolling:touch;border-radius:8px;}
  /* Inputs: 16px prevents iOS zoom */
  input,select,textarea{font-size:16px !important;}
  /* Grids to column */
  .g2,.g3,.g4{grid-template-columns:1fr !important;}
  /* Modals: slide up from bottom */
  .op-modal{align-items:flex-end !important;padding:0 !important;}
  .op-modal>div{border-radius:18px 18px 0 0 !important;max-width:100% !important;width:100% !important;max-height:88vh !important;}
  /* Topbar: compact */
  .topbar{padding:10px 14px !important;}
  .topbar-title{font-size:14px !important;}
  /* Buttons: touch-friendly */
  .btn{min-height:38px;padding:9px 14px !important;font-size:12px !important;}
  .btn-sm{min-height:32px;padding:6px 10px !important;font-size:11px !important;}
  /* Form grid */
  [style*="grid-template-columns:1fr 1fr"]{display:flex !important;flex-direction:column !important;}
  /* Section headers */
  .sec-h{font-size:18px !important;}
  h2{font-size:18px !important;}
  /* Pipeline: horizontal scroll */
  .pipeline-wrap{overflow-x:auto !important;-webkit-overflow-scrolling:touch;}
  .pipeline-col{min-width:240px !important;}
  /* Chart containers */
  canvas,svg{max-width:100% !important;height:auto !important;}
  /* Role selector box */
  .role-box,.role-sel-wrap{padding:10px !important;}
  /* LOC table */
  .loc-table-wrap{overflow-x:auto !important;}
}
@media(max-width:380px){
  .stats{grid-template-columns:1fr !important;}
  .mob-nav-btn{font-size:7px !important;}
  .mob-icon{font-size:16px !important;}
  .sv{font-size:18px !important;}
}
@media(min-width:641px){
  #mobile-nav{display:none !important;}
  #mob-fab{display:none !important;}
}

</style>
</head>
<body>

<!-- ══════════════════════════════════════════════
     LOGIN SCREEN
═══════════════════════════════════════════════ -->
<div id="loginScreen">
  <div class="login-box">
    <div class="login-logo">🏢</div>
    <div class="login-title">Owner's Portal</div>
    <div class="login-sub">We Market Plus LLC — Private Command Center</div>
    <div class="login-field">
      <label>Email</label>
      <input type="email" id="lpEmail" placeholder="owner@wemarketplus.com" autocomplete="username">
    </div>
    <div class="login-field">
      <label>Password</label>
      <input type="password" id="lpPass" placeholder="••••••••••" autocomplete="current-password" onkeydown="if(event.key==='Enter')doLogin()">
    </div>
    <button class="btn-login" onclick="doLogin()">Sign In to Command Center</button>
    <div id="loginError">Invalid credentials. Contact system administrator.</div>
    <div class="login-private">🔒 Private — Authorized access only</div>
  </div>
</div>

<!-- ══════════════════════════════════════════════
     MAIN APP
═══════════════════════════════════════════════ -->
<div id="app">

  <!-- Sidebar -->
  <div class="sidebar">
    <div class="sb-logo">
      <div class="sb-logo-icon">📊</div>
      <div>
        <div class="sb-logo-text">We Market Plus</div>
        <div class="sb-logo-sub">Owner's Portal</div>
      </div>
    </div>

    <div class="sb-sec">Overview</div>
    <button class="sb-btn active" onclick="nav('dashboard')" id="nav-dashboard"><span class="sb-icon">🏠</span>Command Dashboard</button>
    <button class="sb-btn" onclick="nav('revenue')" id="nav-revenue"><span class="sb-icon">💰</span>Revenue Intelligence</button>
    <button class="sb-btn" onclick="nav('customers')" id="nav-customers"><span class="sb-icon">🏢</span>Customer Database</button>

    <div class="sb-sec">Sales</div>
    <button class="sb-btn" onclick="nav('pipeline')" id="nav-pipeline"><span class="sb-icon">📈</span>Sales Pipeline</button>
    <button class="sb-btn" onclick="nav('visitors')" id="nav-visitors"><span class="sb-icon">👁</span>Website Visitors</button>
    <button class="sb-btn" onclick="nav('marketing')" id="nav-marketing"><span class="sb-icon">📣</span>Marketing Performance</button>

    <div class="sb-sec">Health</div>
    <button class="sb-btn" onclick="nav('churn')" id="nav-churn"><span class="sb-icon">⚠️</span>Churn & Risk Engine<span class="sb-badge" id="riskCount">0</span></button>
    <button class="sb-btn" onclick="nav('usage')" id="nav-usage"><span class="sb-icon">📦</span>Product Usage</button>
    <button class="sb-btn" onclick="nav('ai')" id="nav-ai"><span class="sb-icon">🤖</span>AI Business Insights</button>

    <div class="sb-sec">Activity</div>
    <button class="sb-btn" onclick="nav('notes')" id="nav-notes"><span class="sb-icon">📋</span>Communication Log</button>
    <button class="sb-btn" onclick="nav('security')" id="nav-security"><span class="sb-icon">🔐</span>Security & Audit</button>

    <div class="sb-sec">Controls</div>
    <button class="sb-btn" onclick="nav('admin')" id="nav-admin"><span class="sb-icon">⚙️</span>Admin Controls</button>

    <div class="sb-bottom">
      <div class="sb-user">
        <div class="sb-avatar">O</div>
        <div>
          <div style="font-size:12px;font-weight:700;color:var(--text1)">Owner</div>
          <div style="font-size:10px;color:var(--text3)">We Market Plus LLC</div>
        </div>
      </div>
      <button class="sb-btn" onclick="doLogout()" style="color:var(--red)"><span class="sb-icon">↩</span>Sign Out</button>
    </div>
  </div>

  <!-- Main -->
  <div class="main">
    <div class="topbar">
      <div class="topbar-title" id="pageTitle">Command Dashboard</div>
      <div class="topbar-right">
        <span id="liveTag" style="font-size:10px;font-weight:800;color:var(--green);background:var(--green-bg);border-radius:999px;padding:3px 10px">● LIVE</span>
        <span id="topbarDate" style="font-size:11px;color:var(--text3)"></span>
        <button class="btn btn-x btn-sm" onclick="refreshAll()">↻ Refresh</button>
      </div>
    </div>
    <div class="content" id="mainContent">
      <!-- dynamically rendered -->
    </div>
  </div>
</div>

<div id="opToast"></div>

<script>
'use strict';

// ════════════════════════════════════════════════════════════════
// CONFIG
// ════════════════════════════════════════════════════════════════
const BACKEND = 'https://api.wemarketplus.com';
let OP_TOKEN = null;
let CURRENT_PAGE = 'dashboard';

// ════════════════════════════════════════════════════════════════
// TOAST
// ════════════════════════════════════════════════════════════════
function T(msg, type) {
  const el = document.getElementById('opToast');
  el.textContent = msg;
  el.style.borderColor = type === 'e' ? 'rgba(248,113,113,.4)' :
                         type === 'w' ? 'rgba(245,158,11,.4)' :
                         'rgba(61,158,232,.3)';
  el.classList.add('show');
  setTimeout(() => el.classList.remove('show'), 3200);
}

// ════════════════════════════════════════════════════════════════
// AUTH
// ════════════════════════════════════════════════════════════════
async function doLogin() {
  const email = document.getElementById('lpEmail').value.trim();
  const pass  = document.getElementById('lpPass').value;
  const errEl = document.getElementById('loginError');
  errEl.style.display = 'none';

  try {
    const r = await fetch(BACKEND + '/api/owner/login', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email, password: pass }),
    });
    const d = await r.json();
    if (d.error || !d.token) {
      errEl.style.display = 'block';
      return;
    }
    OP_TOKEN = d.token;
    sessionStorage.setItem('op_token', OP_TOKEN);
    document.getElementById('loginScreen').style.display = 'none';
    document.getElementById('app').style.display = 'flex';
    document.getElementById('topbarDate').textContent = new Date().toLocaleDateString('en-US', {weekday:'short',month:'short',day:'numeric'});
    nav('dashboard');
    startAutoRefresh();
  } catch(e) {
    errEl.textContent = 'Connection error. Check backend.';
    errEl.style.display = 'block';
  }
}

function doLogout() {
  OP_TOKEN = null;
  sessionStorage.removeItem('op_token');
  document.getElementById('app').style.display = 'none';
  document.getElementById('loginScreen').style.display = 'flex';
  document.getElementById('lpPass').value = '';
}

async function apiFetch(path, opts = {}) {
  if (!opts.headers) opts.headers = {};
  opts.headers['Authorization'] = 'Bearer ' + OP_TOKEN;
  opts.headers['Content-Type'] = opts.headers['Content-Type'] || 'application/json';
  const r = await fetch(BACKEND + '/api/owner' + path, opts);
  if (r.status === 401) { doLogout(); throw new Error('Unauthorized'); }
  return r.json();
}

// ════════════════════════════════════════════════════════════════
// NAVIGATION
// ════════════════════════════════════════════════════════════════
const PAGE_TITLES = {
  dashboard:'Command Dashboard', revenue:'Revenue Intelligence',
  customers:'Customer Database', pipeline:'Sales Pipeline',
  visitors:'Website Visitors', marketing:'Marketing Performance',
  churn:'Churn & Risk Engine', usage:'Product Usage Analytics',
  ai:'AI Business Insights', notes:'Communication Log',
  security:'Security & Audit', admin:'Admin Controls',
};

function nav(page) {
  CURRENT_PAGE = page;
  document.querySelectorAll('.sb-btn').forEach(b => b.classList.remove('active'));
  const navBtn = document.getElementById('nav-' + page);
  if (navBtn) navBtn.classList.add('active');
  document.getElementById('pageTitle').textContent = PAGE_TITLES[page] || page;
  renderPage(page);
}

function renderPage(page) {
  const mc = document.getElementById('mainContent');
  const renders = {
    dashboard:  renderDashboard,
    revenue:    renderRevenue,
    customers:  renderCustomers,
    pipeline:   renderPipeline,
    visitors:   renderVisitors,
    marketing:  renderMarketing,
    churn:      renderChurn,
    usage:      renderUsage,
    ai:         renderAI,
    notes:      renderNotes,
    security:   renderSecurity,
    admin:      renderAdmin,
  };
