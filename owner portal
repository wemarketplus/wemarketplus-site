<div id="mob-menu-panel" style="position:fixed;top:0;left:0;bottom:0;width:290px;background:#0a1628;z-index:2001;overflow-y:auto;border-right:1px solid rgba(255,255,255,.08);transform:translateX(-100%);transition:transform .28s cubic-bezier(.4,0,.2,1)">
  <div style="padding:20px 16px 12px;border-bottom:1px solid rgba(255,255,255,.07);display:flex;justify-content:space-between;align-items:center;position:sticky;top:0;background:#0a1628;z-index:1">
    <div>
      <div style="font-size:15px;font-weight:900;color:#f4f8ff">All Modules</div>
      <div style="font-size:10px;color:#6b7fa3;margin-top:1px">Tap any section to navigate</div>
    </div>
    <button onclick="toggleMobMenu()" style="background:none;border:none;color:#6b7fa3;font-size:22px;cursor:pointer;width:36px;height:36px;display:flex;align-items:center;justify-content:center;border-radius:50%;background:rgba(255,255,255,.04)">&times;</button>
  </div>
  <div id="mob-menu-links" style="padding:10px 8px 80px"></div>
</div>

<script>
// ════════════════════════════════════════════════════════════════
// MOBILE NAVIGATION + RESPONSIVE SYSTEM
// Works across all CRM and Demo pages
// ════════════════════════════════════════════════════════════════
function setMobNav(key){
  document.querySelectorAll('.mob-nav-btn').forEach(function(b){b.classList.remove('active');});
  var el=document.getElementById('mobnav-'+key);
  if(el)el.classList.add('active');
}

var _mobMenuOpen=false;
function toggleMobMenu(){
  _mobMenuOpen=!_mobMenuOpen;
  var overlay=document.getElementById('mob-menu-overlay');
  var panel=document.getElementById('mob-menu-panel');
  if(panel) panel.style.transform=_mobMenuOpen?'translateX(0px)':'translateX(-100%)';
  if(overlay) overlay.style.display=_mobMenuOpen?'block':'none';
  if(_mobMenuOpen) _buildMobMenuLinks();
}

function _buildMobMenuLinks(){
  var links=document.getElementById('mob-menu-links');
  if(!links) return;
  
  // Try CL-style NAV (object with role keys)
  var navItems=[];
  if(typeof NAV!=='undefined'&&typeof ROLE!=='undefined'&&NAV[ROLE]){
    NAV[ROLE].forEach(function(sec){
      navItems.push({sec:sec.sec,items:sec.items.map(function(item){
        return {k:item.k,l:item.l};
      })});
    });
  }
  // Try HL-style ROLE_TABS (array of tab keys)
  else if(typeof ROLE_TABS!=='undefined'&&typeof currentRole!=='undefined'){
    var tabs=ROLE_TABS[currentRole]||ROLE_TABS['admin']||[];
    var TAB_LABELS={'dash':'Dashboard','leads':'Lead Pipeline','notes':'Notes','aircall':'Aircall',
      'refs':'Referral Sources','pipeline':'Pipeline','territory':'Territory','records':'Prospects',
      'timeline':'Timeline','schedule':'Smart Schedule','aiasst':'AI Assistant','evv':'Mileage/EVV',
      'reports':'Reports','settings':'Settings','team':'Team Management'};
    navItems=[{sec:'NAVIGATION',items:tabs.slice(0,16).map(function(k){return {k:k,l:TAB_LABELS[k]||k};})}];
  }
  
  if(!navItems.length){
    links.innerHTML='<div style="padding:12px;color:#6b7fa3;font-size:12px">Navigation not available</div>';
    return;
  }
  
  links.innerHTML=navItems.map(function(sec){
    return '<div style="margin-bottom:4px">'
      +'<div style="font-size:9px;font-weight:900;color:#4b6278;letter-spacing:.1em;text-transform:uppercase;padding:8px 8px 4px">'+sec.sec+'</div>'
      +sec.items.filter(function(item){return item.l;}).map(function(item){
        // Detect which navigation function to use
        var navFn='';
        if(typeof go==='function') navFn="go('"+item.k+"');toggleMobMenu();setMobNav('"+item.k+"')";
        else if(typeof showTab==='function') navFn="showTab('"+item.k+"');toggleMobMenu()";
        else navFn="toggleMobMenu()";
        return '<button onclick="'+navFn+'" style="display:flex;align-items:center;width:100%;padding:10px 12px;background:none;border:none;color:#c8d6e8;font-size:13px;font-family:inherit;cursor:pointer;border-radius:8px;text-align:left;transition:background .1s" onmouseenter="this.style.background=\'rgba(255,255,255,.06)\'" onmouseleave="this.style.background=\'none\'">'+item.l+'</button>';
      }).join('')
      +'</div>';
  }).join('');
}

// Mobile quick-add FAB (floating action button) 
function _buildMobFAB(){
  if(window.innerWidth>640) return;
  if(document.getElementById('mob-fab')) return;
  var fab=document.createElement('div');
  fab.id='mob-fab';
  fab.style.cssText='position:fixed;bottom:72px;right:16px;z-index:999;';
  var mainBtn=document.createElement('button');
  mainBtn.style.cssText='width:52px;height:52px;border-radius:50%;background:#f59e0b;border:none;color:#06080e;font-size:24px;cursor:pointer;box-shadow:0 4px 16px rgba(245,158,11,.4);font-family:inherit;display:flex;align-items:center;justify-content:center;transition:transform .15s';
  mainBtn.innerHTML='&#43;';
  mainBtn.onclick=function(){
    var menu=document.getElementById('mob-fab-menu');
    if(menu) menu.style.display=menu.style.display==='none'?'flex':'none';
  };
  var fabMenu=document.createElement('div');
  fabMenu.id='mob-fab-menu';
  fabMenu.style.cssText='display:none;flex-direction:column;gap:8px;align-items:flex-end;margin-bottom:8px;';
  
  var quickActions=[
    {label:'Add Lead',fn:"addLeadPrompt&&addLeadPrompt()||T&&T('Add Lead')"},
    {label:'Add Note',fn:"(typeof go==='function'?go('notes'):showTab&&showTab('notes'))"},
    {label:'New Ticket',fn:"addMaintPrompt&&addMaintPrompt()||T&&T('New Ticket')"},
    {label:'Log Mileage',fn:"(typeof go==='function'?go('mileage'):showTab&&showTab('evv'))"},
  ];
  
  fabMenu.innerHTML=quickActions.map(function(a){
    return '<button onclick="'+a.fn+';document.getElementById(\'mob-fab-menu\').style.display=\'none\'" style="background:#0a1628;border:1px solid rgba(245,158,11,.3);border-radius:999px;padding:8px 16px;color:#f59e0b;font-size:12px;font-weight:700;cursor:pointer;font-family:inherit;white-space:nowrap;box-shadow:0 2px 12px rgba(0,0,0,.4)">'+a.label+'</button>';
  }).join('');
  
  fab.appendChild(fabMenu);
  fab.appendChild(mainBtn);
  document.body.appendChild(fab);
}

// Init mobile features
(function initMobile(){
  if(window.innerWidth<=640){
    _buildMobFAB();
  }
  window.addEventListener('resize',function(){
    var fab=document.getElementById('mob-fab');
    if(window.innerWidth<=640){
      if(!fab) _buildMobFAB();
      else fab.style.display='';
    } else {
      if(fab) fab.style.display='none';
      if(_mobMenuOpen) toggleMobMenu();
    }
  });
})();

</script>
